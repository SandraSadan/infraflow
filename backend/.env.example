PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=infraflow_db
DB_USER=postgres
DB_PASSWORD=your_password

# Authentication
AUTH_PROVIDER=demo
DEMO_MODE=true

# JWT
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=1h

# SAML Configuration
SAML_ENTRY_POINT=
SAML_ISSUER=infraflow
SAML_CALLBACK_URL=http://localhost:3000/api/auth/saml/callback
SAML_CERT=
SAML_EMAIL_ATTRIBUTE=email

# LDAP Configuration
LDAP_URL=ldap://localhost:389
LDAP_BASE_DN=
LDAP_USER_DN_TEMPLATE=

RABBITMQ_URL=amqp://localhost:5672

# GITLAB Configuration
GITLAB_API_URL=https://gitlab.com/api/v4
GITLAB_PROJECT_ID=
GITLAB_TRIGGER_TOKEN=
GITLAB_REF=main

# AWX Configuration
AWX_BASE_URL=
AWX_JOB_TEMPLATE_ID=
AWX_TOKEN=
