PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=infraflow_db
DB_USER=postgres
DB_PASSWORD=your_password

# Authentication
AUTH_PROVIDER=demo
DEMO_MODE=true

# JWT
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=1h

# SAML Configuration
SAML_ENTRY_POINT=
SAML_ISSUER=infraflow
SAML_CALLBACK_URL=http://localhost:3000/api/auth/saml/callback
SAML_CERT=

# LDAP Configuration
LDAP_URL=ldap://localhost:389
LDAP_BASE_DN=
LDAP_USER_DN_TEMPLATE=
